# OmniCart Recover — connector credentials
# Copy to .env and fill in the values from each platform's sandbox portal.
# Leave blank to use mock data fallback.

# ---- Shopify Admin API (custom/private app) ----
# Create app in Admin -> Settings -> Apps and sales channels -> Develop apps.
# Token: Admin API access token (Admin API scopes, incl. read_orders).
# Note: for a POC you can also create a Private app in older stores.
SHOPIFY_SHOP_NAME=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2024-01
# SHOPIFY_API_BASE=https://<shop>.myshopify.com/admin/api/

# ---- Lazada Open Platform (Sandbox) ----
# Sandbox console: https://openplatform-sandbox.lazada.com
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
# LAZADA_API_BASE=https://api.lazada.sandbox.learnfromsea.com

# ---- TikTok Shop Partner API (Sandbox) ----
# Sandbox console: https://partners.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
# TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com/api

# ---- Database (MySQL) ----
DATABASE_URL=

# ---- LLM API Keys ----
# Primary: Google Gemini
GEMINI_API_KEY=

# Fallback 1: OpenAI ChatGPT
OPENAI_API_KEY=

# Fallback 2: xAI Grok (uses OpenAI-compatible SDK)
GROK_API_KEY=

# Fallback 3: DeepSeek (uses OpenAI-compatible SDK)
DEEPSEEK_API_KEY=

# Fallback 4: OpenCode (ox-alpha / deepseek-v4-pro, uses OpenAI-compatible SDK)
OPENCODE_API_KEY=