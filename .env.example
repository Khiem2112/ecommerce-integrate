# OmniCart Recover — connector credentials
# Copy to .env and fill in the values from each platform's sandbox portal.
# Leave blank to use mock data fallback.

# ---- Shopify Admin API (custom/private app) ----
# Create app in Admin -> Settings -> Apps and sales channels -> Develop apps.
# Token: Admin API access token (Admin API scopes, incl. read_orders).
# Note: for a POC you can also create a Private app in older stores.
SHOPIFY_SHOP_NAME=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2024-01
# SHOPIFY_API_BASE=https://<shop>.myshopify.com/admin/api/

# ---- Lazada Open Platform (Sandbox) ----
# Sandbox console: https://openplatform-sandbox.lazada.com
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
# Optional IM/Chat credentials (fallback to LAZADA_APP_KEY / LAZADA_APP_SECRET when unset)
LAZADA_CHAT_APP_KEY=
LAZADA_CHAT_APP_SECRET=
# Set to 'true' only to simulate Lazada IM outbound sends without calling Open API
LAZADA_IM_SIMULATE_SEND=false
# Set to 'true' only for local/sandbox webhook testing without valid Lazada HMAC signatures
LAZADA_WEBHOOK_SKIP_SIGNATURE_VERIFY=false
# Delay in milliseconds before running one-time initial Lazada chat history sync after OAuth (default: 900000 = 15 minutes)
LAZADA_INITIAL_CHAT_SYNC_DELAY_MS=900000
# LAZADA_API_BASE=https://api.lazada.sandbox.learnfromsea.com

# ---- TikTok Shop Partner API (Sandbox) ----
# Sandbox console: https://partners.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
# TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com/api

# ---- Database (MySQL) ----
DATABASE_URL=

# ---- LLM API Keys (Priority: Gemini -> DeepSeek -> OpenAI -> Grok -> OpenCode) ----
# Primary: Google Gemini
GEMINI_API_KEY=

# Fallback 1: DeepSeek (uses OpenAI-compatible SDK)
DEEPSEEK_API_KEY=

# Fallback 2: OpenAI ChatGPT
OPENAI_API_KEY=

# Fallback 3: xAI Grok (uses OpenAI-compatible SDK)
GROK_API_KEY=

# Fallback 4: OpenCode (ox-alpha / deepseek-v4-pro, uses OpenAI-compatible SDK)
OPENCODE_API_KEY=

# ---- Ngrok Tunnel (Local OAuth & Webhooks) ----
# Lấy static domain miễn phí tại: https://dashboard.ngrok.com/cloud-edge/domains
# Ví dụ: my-omnicart.ngrok-free.app
NGROK_DOMAIN=yetta-newsworthy-climacterically.ngrok-free.dev
PORT=3000

# ---- RAG LLM Latency & Failover ----
# Per-attempt provider timeout in ms (default: 8000 for simple/standard, 12000 for complex)
# LLM_TIMEOUT_MS=8000
# Total cross-provider fallback deadline in ms (default: 15000)
# LLM_TOTAL_BUDGET_MS=15000
# In-memory retention strategy catalog cache TTL in ms (default: 60000)
# STRATEGY_CACHE_TTL_MS=60000

# ---- Autonomous Bot Queue ----
BOT_DEBOUNCE_MS=3000
# BullMQ worker concurrency per partition (1..16, default 1 preserves intra-partition FIFO ordering)
CHAT_WORKER_CONCURRENCY=1
# Set to 'false' to disable starting BullMQ workers inside the Next.js server process
ENABLE_IN_APP_WORKERS=true

# ---- AWS SQS FIFO Webhook Consumer (Option 2: API Gateway -> Lambda -> SQS FIFO -> BullMQ) ----
# Leave LAZADA_SQS_QUEUE_URL empty to keep the in-app SQS Long Polling consumer disabled
LAZADA_SQS_QUEUE_URL=
AWS_REGION=ap-southeast-1
# Optional dedicated SQS region override (falls back to AWS_REGION, then ap-southeast-1)
# LAZADA_SQS_REGION=ap-southeast-1
# Set IAM credentials when running outside an AWS IAM Role (EC2/ECS/EKS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Long polling wait time in seconds (1..20, default: 20)
LAZADA_SQS_WAIT_TIME_SECONDS=20
# Max messages fetched per SQS poll batch (1..10, default: 10)
LAZADA_SQS_MAX_MESSAGES=10
# Set to 'false' to disable the SQS consumer while keeping BullMQ workers enabled
ENABLE_LAZADA_SQS_CONSUMER=true
